# ============================================================
# Alvessa — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Alvessa
# Canonical public site URL — used by metadata, sitemap.xml and robots.txt.
# Set to https://alvessa.nl in production (falls back to that value if unset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 2: Database & Auth) ---
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 5: Payments) ---
# Use test keys for development, live keys for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps (Phase 4: Booking Engine) ---
# Restrict this key to your domain in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email (Phase 5B: Booking confirmation emails via Resend) ---
# Get API key from resend.com — verify alvessa.nl domain before going live
RESEND_API_KEY=
EMAIL_FROM=noreply@alvessa.nl
# Operational alert recipient — REQUIRED in production: manual-refund alerts
# for cancelled paid bookings are silently skipped if this is unset.
ADMIN_EMAIL=

# --- Analytics (Phase 8: Optimization) ---
# Plausible (privacy-first, GDPR-compliant)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
